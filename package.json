{
  "name": "@webship.co/workspace-docker",
  "version": "1.0.9",
  "description": "Docker Compose for Webship Workspace: the DOCKER menu on every project with a compose file (up, down, restart, ps, logs, a shell in the first service, pull, build), the up/down caption, the published port as the site link. It carries its AI items, each placed in the workspace folder of its kind: an agent, a skill, a command and a prompt. A runtime of @webship.co/workspace-container.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-docker.git"
  },
  "files": [
    "dist/src",
    "ai",
    "features",
    "scripts",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "docker",
    "label": "Docker Compose",
    "needs": {
      "plugins": [
        "ai-agents",
        "ai-skills",
        "ai-commands",
        "ai-prompts"
      ],
      "commands": [
        {
          "command": "docker",
          "hint": "https://docs.docker.com/engine/install/"
        }
      ]
    },
    "typeActions": {
      "docker": [
        "sites",
        "code"
      ]
    },
    "scripts": {
      "hostInstall": "scripts/host-install.sh"
    },
    "ai": {
      "agents": [
        "ai/agents/docker-operator.md"
      ],
      "skills": [
        "ai/skills/docker-menu"
      ],
      "commands": [
        "ai/commands/docker-status.md"
      ],
      "prompts": [
        "ai/prompts/docker-up-and-check.md"
      ]
    },
    "features": [
      "features/docker.feature"
    ]
  },
  "dependencies": {
    "@webship.co/workspace-container": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.2",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
